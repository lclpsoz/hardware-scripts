[Unit]
Description=Pi undervoltage history web page
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/uv-web.py
DynamicUser=yes
SupplementaryGroups=systemd-journal video
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
MemoryMax=64M
Nice=10
Restart=always

[Install]
WantedBy=multi-user.target
